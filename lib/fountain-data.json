  "rules": [
    {
      "id": "Rule:text:Lottery_1",
      "en": "- Fountain of Wishes -"
    },
    {
      "id": "Rule:text:Lottery_10",
      "en": "   Focus Candy x5 9.1%"
    },
    {
      "id": "Rule:text:Lottery_11",
      "en": "   Refining Oil x1 9.1%"
    },
    {
      "id": "Rule:text:Lottery_12",
