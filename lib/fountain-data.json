    },
    {
      "id": "Rule:text:Lottery_14",
      "en": "   Building Upgrade Blueprint x2 21.1%"
    },
    {
      "id": "Rule:text:Lottery_15",
      "en": "   Basic Earnings Card x10 21.1%"
    },
    {
      "id": "Rule:text:Lottery_16",
      "en": "\u25c6 Fairy Bottle can be obtained from the shop, dailies, stages, and events, among other sources."
    },
    {
      "id": "Rule:text:Lottery_17",
      "en": "- Fairy Rewards -"
    },
    {
      "id": "Rule:text:Lottery_18",
      "en": "\u25c6 Release 1 Fairy each time players wish to the Fountain of Wishes."
    },
    {
      "id": "Rule:text:Lottery_19",
      "en": "\u25c6 Players can claim 1 reward for every 500 Fairies released. The unclaimed rewards can be accumulated."
    },
    {
      "id": "Rule:text:Lottery_2",
      "en": "\u25c6 Use Fairy Bottles to make wishes the Fountain of Wishes. A single wish requires 1 Fairy Bottle, while 10 consecutive wishes will spend 9 Fairy Bottles. Each time a wish is made, the fairies of the fountain will return with a random item."
    },
    {
      "id": "Rule:text:Lottery_20",
      "en": "- Acquaint Stone -"
    },
    {
      "id": "Rule:text:Lottery_21",
      "en": "\u25c6 Use Acquaint Stone to invite Fellows and Family to join you in Drakenberg."
    },
    {
      "id": "Rule:text:Lottery_3",
      "en": "\u25c6 Prize pool probabilities:"
    },
    {
      "id": "Rule:text:Lottery_4",
      "en": "   Acquaint Stone x1 0.1%"
    },
    {
      "id": "Rule:text:Lottery_5",
