l":20},{"id":"74","name":"Tomahawk Steak","guests":0,"station":"4","level":20},{"id":"75","name":"Morning Tea Meal","guests":0,"station":"5","level":20},{"id":"76","name":"Chilled Lava Crab","guests":0,"station":"6","level":20},{"id":"77","name":"Dragon Scale Pie","guests":0,"station":"7","level":20},{"id":"78","name":"Crunchy Gembug Soup","guests":0,"station":"8","level":20},{"id":"79","name":"Deluxe Dungeon Master Sashimi","guests":0,"station":"9","level":20},{"id":"80","name":"Deluxe Dungeon Master Hot Pot","guests":0,"station":"10","level":20}],"localRules":[{"id":"Rule:text:SimGame1_1","en":"- Kitchen Station -"},{"id":"Rule:text:SimGame1_10","en":"\u25c6 Spend Stamina Points to serve guests, who will order dishes from the unlocked menu."},{"id":"Rule:text:SimGame1_11","en":"\u25c6 Guests will queue up to order at the inn, with the next guest able to order once the current dish is completed."},{"id":"Rule:text:SimGame1_12","en":"\u25c6 The inn continues to operate even when the player is offline."},{"id":"Rule:text:SimGame1_13","en":"- Special Guests -"},{"id":"Rule:text:SimGame1_14","en":"\u25c6 After meeting certain conditions, special guests may visit, with a maximum of 3 special guests per day."},{"id":"Rule:text:SimGame1_15","en":"\u25c6 Each special guest can only be served once, and serving them will yield special gifts that become treasures of the inn."},{"id":"Rule:text:SimGame1_16","en":"- Treasures of the Inn -"},{"id":"Rule:text:SimGame1_17","en":"\u25c6 The inn's treasures can bring certain enhancements to Transcenders."},{"id":"Rule:text:SimGame1_18","en":"\u25c6 Gifts from special guests need to be upgraded using Gratitude Value, while Meowchelin Medals require leveling up the inn's rating."},{"id":"Rule:text:SimGame1_19","en":"\u25c6 Leveling up the inn's treasures can enhance their effects, making Transcenders more powerful."},{"id":"Rule:text:SimGame1_2","en":"\u25c6 The inn has a total of 10 types of kitchen stations, which require gold to build."},{"id":"Rule:text:SimGame1_20","en":"- Earnings -"},{"id":"Rule:text:SimGame1_21","en":"\u25c6 Inn earnings will be temporarily stored in the deposit box."},{"id":"Rule:text:SimGame1_22","en":"\u25c6 Earnings need to be manually collected, with no upper cap."},{"id":"Rule:text:SimGame1_23","en":"\u25c6 Rewards can be obtained immediately after serving meals."},{"id":"Rule:text:SimGame1_24","en":"- Popularity and Rating -"},{"id":"Rule:text:SimGame1_25","en":"\u25c6 Receiving guests increases popularity and improves the rating."},{"id":"Rule:text:SimGame1_26","en":"\u25c6 Improving the rating attracts more distinguished guests and gains higher finesse."},{"id":"Rule:text:SimGame1_27","en":"\u25c6 Improving the rating can level up the existing Meowchelin Medal."},{"id":"Rule:text:SimGame1_3","en":"\u25c6 Use blueprints to upgrade kitchen stations, increasing popularity and finesse gained after leveling up."},{"id":"Rule:text:SimGame1_4","en":"- Menu -"},{"id":"Rule:text:SimGame1_5","en":"\u25c6 Complete management target tasks to obtain recipes."},{"id":"Rule:text:SimGame1_6","en":"\u25c6 Develop recipes for kitchen stations that meet recipe requirements, and once completed, add them to the inn's menu."},{"id":"Rule:text:SimGame1_7","en":"\u25c6 Serve guests and cook dishes for them to improve dish finesse."},{"id":"Rule:text:SimGame1_8","en":"\u25c6 Dishes can enhance building earnings, with higher levels providing greater boosts to corresponding buildings."},{"id":"Rule:text:SimGame1_9","en":"- Reception -"}],"sandbox":{"buildGoldPerStationId":100,"upgradeBlueprints":"current station level","stationCap":30,"guestStamina":1,"serviceMs":10000,"guestGold":50,"guestBlueprints":1,"guestFinesse":1,"staminaRefill":20,"queueCap":10,"recipeTasks":"waived, retain source guest/station gates"}}
