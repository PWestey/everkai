d":"Plant104","name":"Dragonhorn Shoot","seconds":10800,"amount":10},{"id":"Plant103","name":"Earth Dragon Eggfruit","seconds":21600,"amount":10},{"id":"Plant102","name":"Fire Dragon Eggfruit","seconds":14400,"amount":10},{"id":"Plant106","name":"Hammerfruit","seconds":14400,"amount":10},{"id":"Plant1003","name":"Macaron Bush","seconds":14400,"amount":10},{"id":"Plant1005","name":"Money Tree","seconds":21600,"amount":10},{"id":"Plant1004","name":"Serene World Tree","seconds":14400,"amount":10},{"id":"Plant107","name":"Spikeball Guard","seconds":10800,"amount":10},{"id":"Plant105","name":"Spinebloom","seconds":14400,"amount":10},{"id":"Plant110","name":"Stamina Vine","seconds":21600,"amount":10},{"id":"Plant109","name":"Starmelon","seconds":14400,"amount":10},{"id":"Plant101","name":"Water Dragon Eggfruit","seconds":10800,"amount":10},{"id":"Plant1001","name":"Xocolate Tree","seconds":14400,"amount":10}],"rules":[{"id":"Rule:text:SimGame3Main_1","en":"- Make magic plants spread across the farm -"},{"id":"Rule:text:SimGame3Main_10","en":"\u25c6 With the increase of cultivable land on the farm, there'll be mysterious visitors."},{"id":"Rule:text:SimGame3Main_11","en":"\u25c6 After helping them solve their problems, the mole family will move into the farm."},{"id":"Rule:text:SimGame3Main_12","en":"\u25c6 They can not only help with watering and quick harvesting."},{"id":"Rule:text:SimGame3Main_13","en":"\u25c6 They can even help you grow plants according to the order requirements."},{"id":"Rule:text:SimGame3Main_14","en":"\u25c6 Accumulate knowledge and expand your land."},{"id":"Rule:text:SimGame3Main_15","en":"- Alraune's Shop -"},{"id":"Rule:text:SimGame3Main_16","en":"\u25c6 In the corner of the farm, there is a legendary plant called Alraune."},{"id":"Rule:text:SimGame3Main_17","en":"\u25c6 Wake her up, and you can exchange the magic morning dew obtained from delivering orders for her essence."},{"id":"Rule:text:SimGame3Main_18","en":"\u25c6 Using Alraune's essence potions on fellow can improve their aptitude."},{"id":"Rule:text:SimGame3Main_19","en":"- Money Tree -"},{"id":"Rule:text:SimGame3Main_2","en":"\u25c6 Complete orders and bring Augustine various types of soils."},{"id":"Rule:text:SimGame3Main_20","en":"\u25c6 Another secret in the farm is the existence of the Money Tree,"},{"id":"Rule:text:SimGame3Main_21","en":"\u25c6 Complete enough orders to increase the popularity of the Magic Farm."},{"id":"Rule:text:SimGame3Main_22","en":"\u25c6 Let the money tree sprout and grow."},{"id":"Rule:text:SimGame3Main_3","en":"\u25c6 In exchange for unique magic plants!"},{"id":"Rule:text:SimGame3Main_4","en":"- Expand your Magic Farm -"},{"id":"Rule:text:SimGame3Main_5","en":"\u25c6 Reclaiming the land, sowing seeds, and watering can earn 10 Knowledge."},{"id":"Rule:text:SimGame3Main_6","en":"\u25c6 According to a plant's growth time,"},{"id":"Rule:text:SimGame3Main_7","en":"\u25c6 Transcenders can also obtain extra 2 Knowledge per minutes."},{"id":"Rule:text:SimGame3Main_8","en":"\u25c6 With enough Knowledge, go ask Maxim to reclaim more land plots!"},{"id":"Rule:text:SimGame3Main_9","en":"- The Mole Family -"}],"sandbox":{"seeds":"free","plots":6,"expandKnowledge":"100*current plots","water":"once per crop","growthKnowledge":"2*whole source minutes, awarded once on harvest","levels":"only source level1 growth/yield; no passive effects"}}
