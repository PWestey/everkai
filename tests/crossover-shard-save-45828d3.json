ll","review":false,"order":3,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h4","title":"Feed Finn & Refill Water","notes":"Feed Finn and make sure his water is full.","memo":"","link":"","freq":"daily","diff":"easy","domain":"household","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preFull","review":false,"order":4,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h5","title":"Take supplements","notes":"Take prescribed meds and regular supplements consistently.","memo":"","link":"","freq":"daily","diff":"easy","domain":"health","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preCore","review":false,"order":5,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h6","title":"Sunlight in the Morning","notes":"Get outside or near bright natural light early to help energy, mood, and circadian rhythm.","memo":"","link":"","freq":"daily","diff":"easy","domain":"learning","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preFull","review":false,"order":6,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h7","title":"Outside Before Screens","notes":"When possible, get outside before recreational screens: sunlight, walk, prayer, yard, or trail. Real world before digital worlds.","memo":"","link":"","freq":"daily","diff":"easy","domain":"learning","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preFull","review":false,"order":7,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h8","title":"Meditation / Stillness","notes":"5-10 minutes of silence, breathing, prayerful stillness, or mindfulness. The goal is calm control, not perfection.","memo":"","link":"","freq":"daily","diff":"med","domain":"reflection","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preFull","review":false,"order":8,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h9","title":"Read the Bible","notes":"Read Scripture with attention. Small faithful reading counts more than perfect volume.","memo":"","link":"","freq":"daily","diff":"med","domain":"reflection","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preCore","review":false,"order":9,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h10","title":"Morning Oath / Pray Alone","notes":"Pray by yourself honestly. Bring gratitude, stress, repentance, needs, and obedience before God. Speak your values with conviction: husband, father, Christian, leader, disciplined man.","memo":"","link":"","freq":"daily","diff":"easy","domain":"reflection","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preCore","review":false,"order":10,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h11","title":"Help in the Morning","notes":"Look for one practical way to help the household morning go smoother: girls, dishes, bags, clothes, cleanup, or Megan support.","memo":"","link":"","freq":"daily","diff":"easy","domain":"parenting","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preFull","review":false,"order":11,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h12","title":"Train the Body","notes":"Lift, walk, cardio, boxing, hike, or another meaningful movement session. On rest days, an intentional walk counts.","memo":"","link":"","freq":"daily","diff":"hard","domain":"health","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preCore","review":false,"order":12,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h13","title":"Mobility Workout","notes":"Mobility routine, stretching, soft tissue, decompression, or recovery work. Keep your body usable, not just strong.","memo":"","link":"","freq":"daily","diff":"med","domain":"learning","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preFull","review":false,"order":13,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h14","title":"Daily work review","notes":"Check team queues, stuck work, volume, and tickets at risk of breaching. Surface what needs action in standup or with the right person.","memo":"","link":"","freq":"daily","diff":"med","domain":"career","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preCore","review":false,"order":14,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h15","title":"Project Work","notes":"Protected time on high-value work: Knowledge Ecosystem, ServiceNow, KCS, dashboards, process improvement, strategy, or leadership systems.","memo":"","link":"","freq":"daily","diff":"hard","domain":"career","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preCore","review":false,"order":15,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h16","title":"Clear Emails","notes":"Clear or triage work/personal email. Aim for control, not perfection.","memo":"","link":"","freq":"daily","diff":"med","domain":"career","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preFull","review":false,"order":16,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h17","title":"Clear Texts & Messages","notes":"Clear or triage texts, Teams/Slack, and other important messages that need a response.","memo":"","link":"","freq":"daily","diff":"med","domain":"career","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preFull","review":false,"order":17,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h18","title":"Phone Boundaries Kept","notes":"Avoid default scrolling, especially during family time, bedtime, and work focus blocks.","memo":"","link":"","freq":"daily","diff":"med","domain":"rest","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preFull","review":false,"order":18,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h19","title":"Name It Before I React","notes":"When triggered, anxious, angry, or impatient, pause and name the emotion: 'I'm feeling ___ because ___.' Then choose the next faithful action.","memo":"","link":"","freq":"daily","diff":"hard","domain":"household","days":[0,1,2,3,4,5,6],"block":"midday","gate":"","review":false,"order":19,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h20","title":"Healthy Food Default","notes":"Prioritize protein, vegetables, reasonable calories, hydration, and mostly healthy foods without letting cravings drive the day. If edibles are used, avoid uncontrolled pantry/freezer spirals and stick to a pre-decided snack or meal.","memo":"","link":"","freq":"daily","diff":"med","domain":"health","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preFull","review":false,"order":20,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h21","title":"Guard the Gate","notes":"No porn, no edging, no searching, no testing the boundary, and no 'almost porn.' Also avoid upstream triggers like lust-scrolls, thirst traps, and fantasy rabbit holes. If tempted, do one interrupt action: pray, walk, shower, leave the room, message accountability, or go to bed.","memo":"","link":"","freq":"daily","diff":"hard","domain":"reflection","days":[0,1,2,3,4,5,6],"block":"midday","gate":"","review":false,"order":21,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h22","title":"Protein Anchor","notes":"Hit protein target or include a clear protein source at each main meal. Protein first, cravings second.","memo":"","link":"","freq":"daily","diff":"med","domain":"health","days":[0,1,2,3,4,5,6],"block":"morning","gate":"preFull","review":false,"order":22,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h23","title":"Vegetables With Meals","notes":"Include vegetables with lunch and dinner, or every main meal when realistic. Greens supplements can support but not replace this habit.","memo":"","link":"","freq":"daily","diff":"med","domain":"health","days":[0,1,2,3,4,5,6],"block":"midday","gate":"","review":false,"order":23,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h24","title":"Walk the Realm","notes":"Hit step goal or take an intentional walk. On low-energy days, a purposeful walk still counts as movement leadership.","memo":"","link":"","freq":"daily","diff":"med","domain":"health","days":[0,1,2,3,4,5,6],"block":"midday","gate":"","review":false,"order":24,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h25","title":"Boxing / Conditioning Rep","notes":"Short boxing, bag work, conditioning, intervals, or skill work. Keep it sustainable; it can be a bonus movement rep rather than mandatory hard training.","memo":"","link":"","freq":"daily","diff":"med","domain":"health","days":[0,1,2,3,4,5,6],"block":"midday","gate":"","review":false,"order":25,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h26","title":"Capture Beauty","notes":"Take one intentional iPhone photo of something meaningful, beautiful, funny, or family-related. Collect moments instead of loot.","memo":"","link":"","freq":"daily","diff":"easy","domain":"learning","days":[0,1,2,3,4,5,6],"block":"midday","gate":"","review":false,"order":26,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h27","title":"Spend With Wisdom","notes":"No impulse purchases. Use the 24-hour cart rule for non-urgent items and make spending intentional rather than frictionless.","memo":"","link":"","freq":"daily","diff":"med","domain":"household","days":[0,1,2,3,4,5,6],"block":"midday","gate":"","review":false,"order":27,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h28","title":"End-of-Day Work Shutdown","notes":"Clear the work to-do list, identify tomorrow's top priorities, close loops, and mentally leave work.","memo":"","link":"","freq":"daily","diff":"med","domain":"career","days":[0,1,2,3,4,5,6],"block":"midday","gate":"","review":false,"order":28,"gateOrd":19,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h29","title":"No Phone Around Girls","notes":"When you are with Emmy and Liv, be with them. Phone away unless truly needed. This can also count during wider family time when presence matters.","memo":"","link":"","freq":"daily","diff":"easy","domain":"parenting","days":[0,1,2,3,4,5,6],"block":"evening","gate":"","review":false,"order":29,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0,"milestone":0,"oncePaid":false,"createdAt":1767225600000},{"id":"h30","title":"Ten-Minute Miracle - Emmy","notes":"At least 10 minutes of focused connection with Emmy. Let her lead when possible. No multitasking.","memo":"","link":"","freq":"daily","diff":"med","domain":"parenting","days":[0,1,2,3,4,5,6],"block":"evening","gate":"","review":false,"order":30,"done":false,"pk":"d:2025-12-31","lootedPk":"","streak":0